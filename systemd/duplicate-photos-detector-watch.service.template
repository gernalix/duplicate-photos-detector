[Unit]
Description=Keep duplicate-photos-detector archive index current
After=graphical-session.target

[Service]
Type=simple
ExecStart=__VENV__/bin/grindr-photo watch __ARCHIVE_DIR__ --db __DB_PATH__ --interval 10
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
